IFVERB SEARCH -1
  RANDOM DUMMY1 1 100 0
  ADD DUMMY1 PER
  IFVAR DUMMY1 > 100
    EQUAL FLAG1 1
    ECHO PLAYER You spot a crevice in the side of the cliff!
  ENDIF

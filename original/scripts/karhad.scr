VARIABLE SNOWDAM
VARIABLE PASSGRD
MACRO 49
IFENTRY -1
  IFVAR INTNUM3 ! 1
    RANDOM SNOWDAM 1 50 0
    IFVAR SNOWDAM < 4
      IFCARRY 831 1098
        IFITEM -1 WORN
          DAMAGEPLR COLD 5 The frigid cold air seeps through the coat a little, nipping at your body.
          ECHO OTHERS %N shivers a bit in the icy cold.
        ELSE
          DAMAGEPLR COLD 35 The frigid cold air seeps into your body freezing parts of you nearly solid.
          ECHO OTHERS %N winces from the icy cold air.
        ENDIF
      ELSE
        IFCARRY 564 166 111
          IFITEM -1 WORN
            ECHO PLAYER The frigid cold air blasts at you, but a shimmering curtain of icy emerald coldfire deflects it.
            ECHO OTHERS Around %N a shimmering curtain of icy emerald coldfire is visible for a moment.
          ELSE
            DAMAGEPLR COLD 35 The frigid cold air seeps into your body freezing parts of you nearly solid.
            ECHO OTHERS %N winces from the icy cold air.
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ENDIF
ENDIF
IFPREVERB HOLD -1
  IFVAR REGION = 43
    IFVAR RNUM >= 3732
      IFVAR RNUM < 3809
        CLEARVERB
        ECHO PLAYER It's too hard to follow anyone here.
      ENDIF
    ENDIF
  ENDIF
ENDIF
IFPREVERB FOLLOW -1
  IFVAR REGION = 43
    IFVAR RNUM >= 3732
      IFVAR RNUM < 3809
        CLEARVERB
        ECHO PLAYER It's too hard to follow anyone here.
      ENDIF
    ENDIF
  ENDIF
ENDIF
IFPREVERB SNEAK -1
  IFVAR REGION = 43
    IFVAR RNUM > 3768
      IFVAR RNUM < 3809
        IFVAR MONINROOM ! 0
          ECHO PLAYER The creatures seem to notice your attempt to escape and block you.
          CLEARVERB
        ENDIF
      ENDIF
    ENDIF
  ENDIF
ENDIF

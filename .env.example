# MongoDB connection string (Atlas free tier or local)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/

# JWT secret for session tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth Client ID (get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Same client ID for the Vite frontend build
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Cloudflare Turnstile (anti-bot CAPTCHA on account registration)
# Get both from https://dash.cloudflare.com/?to=/:account/turnstile
# Secret key: backend-only, verifies tokens server-side
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Site key: public, baked into the Vite frontend build to render the widget
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
